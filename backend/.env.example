DATABASE_URL=postgresql://user:password@localhost:5432/auramed
SECRET_KEY=your-secret-key-min-32-chars-auramed-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

BREAST_MODEL_PATH=app/ml/weights/breast_model.pth
CERVICAL_MODEL_PATH=app/ml/weights/cervical_model.pth
PCOS_MODEL_PATH=app/ml/weights/pcos_model.pth

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=noreply@auramed.in
FROM_NAME=AuraMed

# Preview never sends external messages. Set live only after configuring providers.
MESSAGING_MODE=preview
CLINIC_TIMEZONE=Asia/Kolkata
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
# Approved WhatsApp template: variable 1 receives the appointment message.
TWILIO_WHATSAPP_CONTENT_SID=

UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=50
PATIENT_PORTAL_URL=http://localhost:5173/patient

CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Run one supervised reminder worker; disable embedded scheduling when using it.
NOTIFICATION_SCHEDULER_ENABLED=true
# Never silently switch production databases on connection failure.
ALLOW_DATABASE_FALLBACK=false
